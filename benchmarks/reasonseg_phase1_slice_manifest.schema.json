{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasonseg.local/schemas/reasonseg_phase1_slice_manifest.schema.json",
  "title": "ReasonSeg Phase-1 Slice Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_kind",
    "benchmark_spec_version",
    "entries"
  ],
  "properties": {
    "manifest_kind": {
      "const": "phase1_materialized_slice_manifest"
    },
    "benchmark_spec_version": {
      "type": "string"
    },
    "demo_only": {
      "type": "boolean"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verb",
        "target"
      ],
      "properties": {
        "verb": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "query_struct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "attributes",
        "relations",
        "actions",
        "negatives",
        "exists"
      ],
      "properties": {
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "negatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exists": {
          "type": "boolean"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_role",
        "split",
        "image_id",
        "query_text",
        "query_struct",
        "requested_target",
        "slice_tags",
        "image_category_names",
        "positive_mask_count",
        "source_annotation_ids"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_role": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "type": "string",
          "minLength": 1
        },
        "image_id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "query_text": {
          "type": "string",
          "minLength": 1
        },
        "query_struct": {
          "$ref": "#/$defs/query_struct"
        },
        "requested_target": {
          "type": "string",
          "minLength": 1
        },
        "slice_tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "image_category_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "positive_mask_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_annotation_ids": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "string"
            ]
          }
        }
      }
    }
  }
}
